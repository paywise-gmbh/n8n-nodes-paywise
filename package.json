{
	"name": "@paywise/n8n-nodes-paywise",
	"version": "1.0.1",
	"description": "paywise API integration for n8n - German debt collection (Inkasso)",
	"keywords": [
		"n8n-community-node-package",
		"paywise",
		"debt-collection",
		"inkasso"
	],
	"license": "MIT",
	"homepage": "https://github.com/paywise-gmbh/n8n-nodes-paywise#readme",
	"author": {
		"name": "paywise GmbH",
		"email": "info@paywise.de"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/paywise-gmbh/n8n-nodes-paywise.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"format": "prettier nodes credentials --write",
		"test": "node --test test/*.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PaywiseApi.credentials.js",
			"dist/credentials/PaywiseV2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Paywise/Paywise.node.js",
			"dist/nodes/PaywiseTrigger/PaywiseTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.51.5",
		"eslint": "^9.39.4",
		"n8n-workflow": "^2.16.0",
		"prettier": "^3.8.3",
		"release-it": "^20.2.0",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
