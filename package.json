{
  "name": "@paywise/n8n-nodes-paywise",
  "version": "0.1.8",
  "description": "Paywise API integration for n8n - German Debt Collection Agency",
  "keywords": [
    "n8n-community-node-package",
    "paywise",
    "debt-collection",
    "inkasso"
  ],
  "license": "MIT",
  "homepage": "https://paywise.de",
  "author": {
    "name": "Thomas Pannek",
    "email": "t.pannek@paywise.de"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paywise/n8n-nodes-paywise"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp copy:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint -c .eslintrc.js nodes credentials package.json",
    "lintfix": "eslint -c .eslintrc.js nodes credentials package.json --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PaywiseApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/paywise/Paywise.node.js"
    ]
  },
  "devDependencies": {
    "@types/express": "^4.17.6",
    "@types/request-promise-native": "~1.0.15",
    "@typescript-eslint/parser": "~5.45",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "gulp": "^4.0.2",
    "n8n-core": "^0.125.0",
    "n8n-workflow": "^0.107.0",
    "prettier": "^2.7.1",
    "typescript": "~4.8.4"
  }
}